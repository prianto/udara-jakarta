{
  "name": "udara-jakarta",
  "version": "1.0.0",
  "description": "Collects air-quality readings from the Udara Jakarta, stores them in SQLite, and serves them through a small HTTP API.",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "scrape:stations": "node scripts/scrape-stations.js",
    "scrape:measurements": "node scripts/scrape-measurements.js",
    "db:init": "node scripts/init-db.js db/data.sqlite",
    "db:example": "node scripts/init-db.js db/data.sqlite.example",
    "test": "node --test"
  },
  "keywords": [
    "scraper",
    "sqlite",
    "api",
    "cheerio",
    "fastify"
  ],
  "author": "",
  "license": "ISC",
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "@fastify/cors": "^11.4.1",
    "cheerio": "^1.1.0",
    "fastify": "^5.2.0",
    "node-cron": "^4.6.0",
    "pngjs": "^7.0.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.16.1",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.16.1",
  "type": "module"
}